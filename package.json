{
  "name": "pnpm-mono",
  "version": "1.0.0",
  "description": "the project will have everything",
  "scripts": {
    "postinstall": "husky install",
    "clean": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' + & rm pnpm-lock.yaml",
    "commit": "git-cz",
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "docker:mono:container": "docker build . --target mono-dep --tag mono-dep:latest -f ./docker/build.Dockerfile",
    "lint": "eslint .",
    "lint:all": "nx run-many -t lint",
    "copy-eslint-config": "node scripts/copy-eslint-config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@commitlint/config-pnpm-scopes": "^17.8.1",
    "@commitlint/cz-commitlint": "^17.8.1",
    "@repo/eslint-config-react": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chalk": "^5.3.0",
    "commitizen": "^4.3.0",
    "cypress": "^13.6.2",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "27.5.1",
    "lint-staged": "^14.0.1",
    "nx": "^16.10.0",
    "nx-cloud": "^16.5.2",
    "prettier": "^3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "syncpack": "^11.2.1",
    "typescript": "5.5.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.10.0"
}
